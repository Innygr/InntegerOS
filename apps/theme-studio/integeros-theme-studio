#!/usr/bin/env python3
"""InntegerOS Theme Studio: paired light/dark KDE desktop presets."""
from __future__ import annotations

import shutil
import subprocess
import tkinter as tk
from pathlib import Path
from tkinter import messagebox

APP_NAME = "InntegerOS Theme Studio"
SCHEME_DIRS = (
    Path.home() / ".local/share/color-schemes",
    Path("/usr/local/share/color-schemes"),
    Path("/usr/share/color-schemes"),
)
WALLPAPER_HELPERS = (
    Path(__file__).resolve().parents[2] / "scripts/apply-wallpaper.sh",
    Path.home() / ".local/share/integeros/scripts/apply-wallpaper.sh",
)

# Every family offers both modes. Kubuntu schemes are preferred when installed;
# the matching Breeze scheme is the safe fallback on stock KDE installations.
THEMES = (
    ("InntegerOS", "Official violet/cyan branding",
     ("InntegerOS Light", "InntegerOSLight", "InnyGrOSLight"),
     ("InntegerOS Dark", "InnyGrOS", "InntegerOSDark")),
    ("Kubuntu", "Kubuntu palette where available; Breeze fallback",
     ("KubuntuLight", "Kubuntu", "BreezeLight"),
     ("KubuntuDark", "Kubuntu", "BreezeDark")),
    ("Breeze", "KDE's classic desktop appearance",
     ("BreezeLight",), ("BreezeDark",)),
)


def installed_scheme_ids() -> set[str]:
    found: set[str] = set()
    for directory in SCHEME_DIRS:
        if directory.is_dir():
            found.update(path.stem for path in directory.glob("*.colors"))
    return found


def find_wallpaper_helper() -> Path | None:
    return next((path for path in WALLPAPER_HELPERS if path.is_file()), None)


def open_settings(module: str) -> None:
    executable = shutil.which("systemsettings")
    if not executable:
        messagebox.showerror(APP_NAME, "KDE System Settings (systemsettings) was not found.")
        return
    try:
        subprocess.Popen([executable, module], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError as exc:
        messagebox.showerror(APP_NAME, f"Could not open System Settings.\n\n{exc}")


def apply_scheme(family: str, mode: str, candidates: tuple[str, ...], available: set[str]) -> None:
    scheme = next((candidate for candidate in candidates if candidate in available), None)
    if not scheme:
        messagebox.showwarning(
            APP_NAME,
            f"{family} {mode} is not installed.\n\n"
            "No theme was downloaded. Open KDE Colors settings to browse available schemes.",
        )
        open_settings("kcm_colors")
        return
    executable = shutil.which("plasma-apply-colorscheme")
    if not executable:
        messagebox.showerror(APP_NAME, "plasma-apply-colorscheme was not found.")
        open_settings("kcm_colors")
        return
    try:
        result = subprocess.run([executable, scheme], check=False, text=True,
                                capture_output=True, timeout=90)
    except (OSError, subprocess.TimeoutExpired) as exc:
        messagebox.showerror(APP_NAME, f"Could not apply {family} {mode}.\n\n{exc}")
        return
    if result.returncode:
        detail = (result.stderr or result.stdout).strip()
        messagebox.showwarning(APP_NAME, f"Applying {family} {mode} failed.\n\n{detail or 'No details provided.'}")
        return
    fallback = ""
    if family == "Kubuntu" and scheme.startswith("Breeze"):
        fallback = f"\n\nThe Kubuntu-specific scheme was not found, so {scheme} was used."
    messagebox.showinfo(APP_NAME, f"{family} {mode} applied using {scheme}.{fallback}")


def choose_wallpaper() -> None:
    helper = find_wallpaper_helper()
    if helper:
        try:
            result = subprocess.run(["bash", str(helper), "--choose"], check=False,
                                    text=True, capture_output=True, timeout=90)
        except (OSError, subprocess.TimeoutExpired) as exc:
            messagebox.showerror(APP_NAME, f"Wallpaper chooser could not start.\n\n{exc}")
            return
        if result.returncode:
            messagebox.showwarning(APP_NAME, (result.stderr or result.stdout).strip() or "Wallpaper chooser failed.")
        return
    open_settings("kcm_wallpaper")


def build_window() -> tk.Tk:
    root = tk.Tk()
    root.title(APP_NAME)
    root.geometry("760x700")
    root.minsize(650, 620)
    root.configure(bg="#090b18")

    tk.Label(root, text="THEME STUDIO", bg="#090b18", fg="#55eaff",
             font=("DejaVu Sans", 23, "bold")).pack(anchor="w", padx=28, pady=(22, 4))
    tk.Label(
        root,
        text="Every theme family has a light and dark option. Applying a preset changes the KDE colour scheme only.",
        bg="#090b18", fg="#b8bfdc", font=("DejaVu Sans", 10), wraplength=690, justify="left",
    ).pack(anchor="w", padx=30, pady=(0, 18))

    tk.Label(root, text="LIGHT  /  DARK PRESETS", bg="#090b18", fg="#a58bff",
             font=("DejaVu Sans", 11, "bold")).pack(anchor="w", padx=30, pady=(0, 7))
    available = installed_scheme_ids()

    for family, description, light_candidates, dark_candidates in THEMES:
        card = tk.Frame(root, bg="#151a30", highlightbackground="#30395c", highlightthickness=1)
        card.pack(fill="x", padx=28, pady=5)
        info = tk.Frame(card, bg="#151a30")
        info.pack(fill="x", padx=14, pady=(9, 4))
        tk.Label(info, text=family, bg="#151a30", fg="#f1f3ff",
                 font=("DejaVu Sans", 11, "bold")).pack(anchor="w")
        tk.Label(info, text=description, bg="#151a30", fg="#aeb7d4",
                 font=("DejaVu Sans", 9)).pack(anchor="w", pady=(2, 0))
        buttons = tk.Frame(card, bg="#151a30")
        buttons.pack(fill="x", padx=10, pady=(4, 10))
        for mode, candidates, label in (
            ("Light", light_candidates, "☀  LIGHT"),
            ("Dark", dark_candidates, "☾  DARK"),
        ):
            found = next((name for name in candidates if name in available), None)
            status = "Available" if found else "Not installed"
            group = tk.Frame(buttons, bg="#151a30")
            group.pack(side="left", expand=True, fill="x", padx=4)
            tk.Button(
                group, text=label,
                command=lambda f=family, m=mode, c=candidates: apply_scheme(f, m, c, available),
                bg="#e7eaf4" if mode == "Light" else "#24304d",
                fg="#20243a" if mode == "Light" else "#55eaff",
                activebackground="#cbd5eb" if mode == "Light" else "#35466e",
                activeforeground="#20243a" if mode == "Light" else "#ffffff",
                relief="flat", padx=12, pady=8, cursor="hand2",
            ).pack(fill="x")
            tk.Label(group, text=f"{status}: {found}" if found else status,
                     bg="#151a30", fg="#73dfb0" if found else "#e6b86a",
                     font=("DejaVu Sans", 8)).pack(anchor="w", pady=(3, 0))

    tk.Label(root, text="MORE APPEARANCE SETTINGS", bg="#090b18", fg="#a58bff",
             font=("DejaVu Sans", 11, "bold")).pack(anchor="w", padx=30, pady=(13, 5))

    row = tk.Frame(root, bg="#151a30")
    row.pack(fill="x", padx=28, pady=3)
    tk.Button(row, text="KDE COLOUR SETTINGS / SYSTEM DEFAULT",
              command=lambda: open_settings("kcm_colors"), bg="#30294c", fg="#e4dcff",
              activebackground="#403763", activeforeground="#ffffff",
              relief="flat", padx=12, pady=9).pack(fill="x", padx=8, pady=7)

    row2 = tk.Frame(root, bg="#151a30")
    row2.pack(fill="x", padx=28, pady=3)
    for label, module in (("Wallpaper", None), ("Icons", "kcm_icons"),
                          ("Global theme", "kcm_lookandfeel"), ("Fonts", "kcm_fonts")):
        command = choose_wallpaper if module is None else lambda m=module: open_settings(m)
        tk.Button(row2, text=label, command=command, bg="#24304d", fg="#55eaff",
                  activebackground="#35466e", activeforeground="#ffffff",
                  relief="flat", padx=10, pady=8).pack(side="left", expand=True, fill="x", padx=4, pady=7)

    tk.Label(root, text="Colour presets do not alter wallpaper, icons, cursor, fonts, or Plasma layout.",
             bg="#090b18", fg="#7f89a8", font=("DejaVu Sans", 8)).pack(anchor="w", padx=30, pady=12)
    return root


if __name__ == "__main__":
    build_window().mainloop()
