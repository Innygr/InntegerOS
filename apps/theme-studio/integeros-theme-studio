#!/usr/bin/env python3
"""InntegerOS Theme Studio: desktop theme presets and KDE appearance controls."""
from __future__ import annotations

import shutil
import subprocess
import tkinter as tk
from pathlib import Path
from tkinter import messagebox

APP_NAME = "InntegerOS Theme Studio"
COLOR_SCHEME = "InnyGrOS"
SCHEME_DIRS = (
    Path.home() / ".local/share/color-schemes",
    Path("/usr/local/share/color-schemes"),
    Path("/usr/share/color-schemes"),
)
WALLPAPER_HELPERS = (
    Path(__file__).resolve().parents[2] / "scripts/apply-wallpaper.sh",
    Path.home() / ".local/share/integeros/scripts/apply-wallpaper.sh",
)

# Each preset resolves to an installed KDE colour-scheme file. Kubuntu Dark
# prefers a Kubuntu-provided scheme and safely falls back to Breeze Dark.
PRESETS = (
    ("InntegerOS Dark", "Violet accents with a deep navy desktop.", ("InnyGrOS",)),
    ("Kubuntu Dark", "Kubuntu's dark scheme when installed; otherwise Breeze Dark.",
     ("KubuntuDark", "Kubuntu", "BreezeDark")),
    ("Breeze Light", "The clean, bright KDE Breeze appearance.", ("BreezeLight",)),
    ("Breeze Dark", "The standard dark KDE Breeze appearance.", ("BreezeDark",)),
)


def installed_scheme_ids() -> set[str]:
    found: set[str] = set()
    for directory in SCHEME_DIRS:
        if directory.is_dir():
            found.update(path.stem for path in directory.glob("*.colors"))
    return found


def find_wallpaper_helper() -> Path | None:
    return next((path for path in WALLPAPER_HELPERS if path.is_file()), None)


def show_command_result(command: list[str], description: str) -> bool:
    try:
        result = subprocess.run(command, check=False, text=True, capture_output=True, timeout=90)
    except (OSError, subprocess.TimeoutExpired) as exc:
        messagebox.showerror(APP_NAME, f"{description} could not be started.\n\n{exc}")
        return False
    if result.returncode:
        detail = (result.stderr or result.stdout).strip()
        messagebox.showwarning(APP_NAME, f"{description} did not complete.\n\n{detail or 'No details were provided.'}")
        return False
    return True


def open_settings(module: str) -> None:
    executable = shutil.which("systemsettings")
    if not executable:
        messagebox.showerror(APP_NAME, "KDE System Settings (systemsettings) was not found.")
        return
    try:
        subprocess.Popen([executable, module], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    except OSError as exc:
        messagebox.showerror(APP_NAME, f"Could not open System Settings.\n\n{exc}")


def apply_preset(label: str, candidates: tuple[str, ...], available: set[str]) -> None:
    executable = shutil.which("plasma-apply-colorscheme")
    if not executable:
        messagebox.showerror(APP_NAME, "plasma-apply-colorscheme was not found. Open KDE's Colors settings instead.")
        open_settings("kcm_colors")
        return
    scheme = next((candidate for candidate in candidates if candidate in available), None)
    if not scheme:
        messagebox.showwarning(
            APP_NAME,
            f"{label} is not installed on this system.\n\n"
            "No packages or themes were downloaded. Open Colors & Themes to see available schemes.",
        )
        open_settings("kcm_colors")
        return
    if show_command_result([executable, scheme], f"Applying {label}"):
        note = f"\n\nKDE colour scheme: {scheme}"
        if label == "Kubuntu Dark" and scheme != "KubuntuDark":
            note += "\nThe Kubuntu-specific scheme was not found, so Breeze Dark was used."
        messagebox.showinfo(APP_NAME, f"{label} applied.{note}")


def apply_colors() -> None:
    apply_preset("InntegerOS Dark", (COLOR_SCHEME,), installed_scheme_ids())


def choose_wallpaper() -> None:
    helper = find_wallpaper_helper()
    if helper:
        show_command_result(["bash", str(helper), "--choose"], "Opening the wallpaper chooser")
        return
    messagebox.showwarning(APP_NAME, "The InntegerOS wallpaper helper was not found. KDE Wallpaper settings will open.")
    open_settings("kcm_wallpaper")


def build_window() -> tk.Tk:
    root = tk.Tk()
    root.title(APP_NAME)
    root.geometry("720x760")
    root.minsize(600, 650)
    root.configure(bg="#090b18")

    title = tk.Label(root, text="THEME STUDIO", bg="#090b18", fg="#55eaff",
                     font=("DejaVu Sans", 23, "bold"))
    title.pack(anchor="w", padx=28, pady=(24, 4))
    subtitle = tk.Label(
        root,
        text="Choose a desktop look. Presets change KDE's colour scheme; wallpapers, icons and other settings stay untouched.",
        bg="#090b18", fg="#b8bfdc", font=("DejaVu Sans", 10), wraplength=650, justify="left",
    )
    subtitle.pack(anchor="w", padx=30, pady=(0, 18))

    section = tk.Label(root, text="DESKTOP THEME PRESETS", bg="#090b18", fg="#a58bff",
                       font=("DejaVu Sans", 11, "bold"))
    section.pack(anchor="w", padx=30, pady=(4, 6))

    available = installed_scheme_ids()

    def theme_card(label: str, detail: str, candidates: tuple[str, ...]) -> None:
        scheme = next((candidate for candidate in candidates if candidate in available), None)
        row = tk.Frame(root, bg="#151a30", highlightbackground="#30395c", highlightthickness=1)
        row.pack(fill="x", padx=28, pady=4)
        text_box = tk.Frame(row, bg="#151a30")
        text_box.pack(side="left", fill="both", expand=True, padx=13, pady=9)
        tk.Label(text_box, text=label, bg="#151a30", fg="#f1f3ff",
                 font=("DejaVu Sans", 10, "bold")).pack(anchor="w")
        tk.Label(text_box, text=detail, bg="#151a30", fg="#aeb7d4",
                 font=("DejaVu Sans", 9), wraplength=420, justify="left").pack(anchor="w", pady=(2, 0))
        status = "Available" if scheme else "Not installed"
        tk.Label(text_box, text=status, bg="#151a30", fg="#73dfb0" if scheme else "#e6b86a",
                 font=("DejaVu Sans", 8, "bold")).pack(anchor="w", pady=(3, 0))
        tk.Button(
            row, text="APPLY" if scheme else "VIEW", 
            command=(lambda l=label, c=candidates: apply_preset(l, c, available)) if scheme
                    else (lambda: open_settings("kcm_colors")),
            bg="#24304d", fg="#55eaff", activebackground="#35466e",
            activeforeground="#ffffff", relief="flat", padx=14, pady=7, cursor="hand2",
        ).pack(side="right", padx=12)

    for preset in PRESETS:
        theme_card(*preset)

    tk.Button(
        root, text="SYSTEM DEFAULT / MORE COLOUR SCHEMES",
        command=lambda: open_settings("kcm_colors"), bg="#30294c", fg="#e4dcff",
        activebackground="#403763", activeforeground="#ffffff",
        relief="flat", padx=12, pady=9, cursor="hand2",
    ).pack(fill="x", padx=28, pady=(8, 12))

    section2 = tk.Label(root, text="OTHER APPEARANCE SETTINGS", bg="#090b18", fg="#a58bff",
                        font=("DejaVu Sans", 11, "bold"))
    section2.pack(anchor="w", padx=30, pady=(6, 4))

    def action(label: str, detail: str, command) -> None:
        row = tk.Frame(root, bg="#151a30", highlightbackground="#30395c", highlightthickness=1)
        row.pack(fill="x", padx=28, pady=3)
        text_box = tk.Frame(row, bg="#151a30")
        text_box.pack(side="left", fill="both", expand=True, padx=12, pady=7)
        tk.Label(text_box, text=label, bg="#151a30", fg="#f1f3ff",
                 font=("DejaVu Sans", 9, "bold")).pack(anchor="w")
        tk.Label(text_box, text=detail, bg="#151a30", fg="#aeb7d4",
                 font=("DejaVu Sans", 8), wraplength=440, justify="left").pack(anchor="w", pady=(1, 0))
        tk.Button(row, text="OPEN", command=command, bg="#24304d", fg="#55eaff",
                  activebackground="#35466e", activeforeground="#ffffff",
                  relief="flat", padx=12, pady=6, cursor="hand2").pack(side="right", padx=10)

    action("Wallpaper", "Choose a desktop background.", choose_wallpaper)
    action("Icons and cursors", "Manage icon and pointer themes.", lambda: open_settings("kcm_icons"))
    action("Global theme", "Explore full Plasma themes and layouts.", lambda: open_settings("kcm_lookandfeel"))
    action("Fonts", "Adjust interface and application fonts.", lambda: open_settings("kcm_fonts"))

    tk.Label(
        root, text="Presets only apply installed KDE colour schemes. No themes are downloaded and no system-wide files are modified.",
        bg="#090b18", fg="#7f89a8", font=("DejaVu Sans", 8), wraplength=650,
    ).pack(anchor="w", padx=30, pady=(12, 16))
    return root


if __name__ == "__main__":
    build_window().mainloop()
